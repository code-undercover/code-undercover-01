{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=cctnygrxrxmbegwtwaod&features=docs%2Cdatabase%2Cdebugging%2Cfunctions",
      "enabled": true,
      "timeout": 60000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "supabase_execute_sql": "ask",
    "supabase_apply_migration": "ask",
    "supabase_deploy_edge_function": "ask",
    "github_create_pull_request": "ask",
    "github_push_files": "ask",
    "github_create_or_update_file": "ask",
    "github_delete_file": "ask",
    "github_merge_pull_request": "ask",
    "render_create_*": "ask",
    "render_update_*": "ask"
  }
}
