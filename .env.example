# PostgreSQL via Supabase (or any Postgres provider)
# For local dev, you can use a local Postgres instance:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/code_undercover"
#
# Use a DIRECT connection here, not the pooler. RLS is enabled on every table
# with no policies, so any role without BYPASSRLS reads zero rows — and Supabase's
# pooler authenticates as a non-BYPASSRLS role. Pointing DATABASE_URL at the
# pooler therefore makes every query return empty with no error.
DATABASE_URL="postgresql://user:password@host:5432/postgres"
# Prisma needs a non-pooled connection for migrations (Supabase: same host, no ?pgbouncer=true, port 5432)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
# Set to your production domain in prod (e.g. https://code-undercover.onrender.com)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (https://resend.com/api-keys) — sends password reset emails.
RESEND_API_KEY="your-resend-api-key"
# Must be on a domain verified in Resend to send to arbitrary recipients.
# Until then, the onboarding@resend.dev default only delivers to your own
# Resend account email.
EMAIL_FROM="Code Undercover Agency <onboarding@resend.dev>"

# Supabase project API-layer credentials, distinct from DATABASE_URL/DIRECT_URL
# above, which Prisma uses for direct Postgres access.
#
# NOTE: nothing in the app currently reads the secret key or the JWKS URL. The
# only Supabase consumer is app/auth/callback/route.ts, which uses the
# publishable/anon key for auth.getSession() and is not linked from any page —
# Google sign-in goes through NextAuth instead (see GOOGLE_CLIENT_ID above).
# Leave these unset unless that route is wired up.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Same project, NEXT_PUBLIC_-prefixed so utils/supabase/client.ts (browser)
# can read them. The publishable key is safe to expose — never add a
# NEXT_PUBLIC_ version of the secret key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Judge0 self-hosted code execution API (see docker-compose.yml / judge0.conf.example).
# In Docker Compose this resolves to the judge0-server container; only meaningful
# when running the full compose stack, not `npm run dev` on its own.
JUDGE0_API_URL="http://judge0-server:2358"
# Judge0 language id for "C (GCC 9.2.0)" — verified present on the self-hosted
# judge0/judge0:latest image (the newer "C (GCC 14.1.0)"/id 103 seen on the
# public ce.judge0.com instance is NOT in this image). Re-verify with
# GET {JUDGE0_API_URL}/languages/all if you change the Judge0 image/version.
JUDGE0_C_LANGUAGE_ID=50

# Upstash Redis (https://console.upstash.com) — backs the rate limiters in
# lib/rate-limit.ts and the cache in lib/cache.ts. Optional in development, but
# REQUIRED in production: without it both modules throw rather than fall back to
# a per-instance counter that neither shares across replicas nor survives restart.
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
